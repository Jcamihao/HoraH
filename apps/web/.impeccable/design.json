  "narrative": {
    "northStar": "A Lista do Aparelho",
    "overview": "O painel parece a lista de ajustes do próprio celular: título grande, grupos de linhas brancas separadas por um filete e uma cor só para o que se toca. A marca do Hora H ainda não existe, então a identidade é neutra de propósito e trocável por tokens.",
    "keyCharacteristics": [
      "Título grande que encolhe para a barra ao rolar",
      "Grupos brancos de canto 12px sobre cinza-claro",
      "Uma cor de ação; verde, âmbar e vermelho só para estado",
      "Fonte do sistema",
      "Telas entram pelo lado"
    ],
    "rules": [
      {
        "name": "The Only-Touch Rule",
        "body": "O azul de ação aparece só em quem responde ao toque.",
        "section": "colors"
      },
      {
        "name": "The State-Not-Style Rule",
        "body": "Verde, âmbar e vermelho existem só para estado.",
        "section": "colors"
      },
      {
        "name": "The Tabular-Money Rule",
        "body": "Preço, horário e duração usam algarismos tabulares.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Grupos e botões não têm sombra; ela só marca o que o dedo move.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do usar azul de ação só em quem responde ao toque.",
      "Do agrupar linhas em um grupo branco de canto 12px com filete recuado de 16px.",
      "Do mostrar o estado com etiqueta e texto, nunca só com cor.",
      "Do manter o campo de formulário em 16px ou mais e a área de toque em 44px ou mais.",
      "Do trocar a marca editando só src/styles/_tokens.scss."
    ],
    "donts": [
      "Don't pôr cartão dentro de cartão.",
      "Don't usar verde, âmbar ou vermelho como enfeite.",
      "Don't usar sombra pesada, desfoque decorativo ou gradiente em texto.",
      "Don't pôr um rótulo pequeno em caixa-alta acima de um título.",
      "Don't inventar números, clientes ou provas."
    ]
  }
