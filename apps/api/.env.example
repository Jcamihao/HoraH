# Copie para .env (apps/api/.env) e ajuste. Nunca commite o .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://horah:horah@localhost:5440/horah?schema=public
# Mínimo 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-isto-por-um-segredo-longo-e-aleatorio-com-32-ou-mais
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30
# Em produção os cookies só trafegam por HTTPS.
COOKIE_SECURE=false
APP_BASE_URL=http://localhost:4200
# Quantos proxies reversos confiáveis ficam na frente da API (0 em dev, 1 atrás do Nginx/Caddy).
TRUST_PROXY=0
THROTTLE_ENABLED=true
TRIAL_DAYS=7

# Cobrança (Fase 3). Sem ASAAS_API_KEY a tela de assinatura avisa que a cobrança não está configurada.
# Sandbox: https://api-sandbox.asaas.com/v3 (padrão). Produção: https://api.asaas.com/v3 (só de propósito).
# A chave do Asaas começa com "$": entre aspas simples.
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Segredo longo e aleatório; é o mesmo que vai no webhook configurado no painel do Asaas.
ASAAS_WEBHOOK_TOKEN=

# E-mail (Resend). Em desenvolvimento, MAIL_PROVIDER=log só escreve o e-mail no log.
MAIL_PROVIDER=log
RESEND_API_KEY=
MAIL_FROM=Hora H <onboarding@resend.dev>

# Fila dos jobs (BullMQ). Obrigatória em produção. Sem ela, em desenvolvimento, os jobs rodam num temporizador.
REDIS_URL=
ROTINAS_INTERVALO_MIN=10
